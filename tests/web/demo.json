{
 "name": "the demo path in the browser: talk, stay, build, walk, a story, a song, a lantern",
 "steps": [
  {
   "goto": "/?fresh=1&pace=0.5"
  },
  {
   "label": "the island is ready",
   "eval": "document.querySelector('.home')?.dataset.loaded === 'yes'",
   "equals": true,
   "within": 90
  },
  {
   "click": ".tag-look"
  },
  {
   "label": "the controls note shows once",
   "eval": "!document.querySelector('.desk-hint').hidden",
   "equals": true,
   "within": 5
  },
  {
   "label": "a traveler arrives and talks",
   "eval": "store.phase.value",
   "equals": "talk",
   "within": 180
  },
  {
   "label": "reply choices as paper bubbles",
   "eval": "store.choices.value.length >= 3",
   "equals": true,
   "within": 20
  },
  {
   "shot": "demo-desk-1-talk.png"
  },
  {
   "label": "answer with the first choice",
   "eval": "(document.querySelector('.desk-choice').click(), true)",
   "equals": true
  },
  {
   "label": "new choices come",
   "eval": "store.choices.value.length >= 2",
   "equals": true,
   "within": 90
  },
  {
   "label": "a stay choice is offered",
   "eval": "flow.stayIndex() >= 0",
   "equals": true,
   "within": 90
  },
  {
   "label": "ask them to stay",
   "eval": "(document.querySelectorAll('.desk-choice')[flow.stayIndex()].click(), true)",
   "equals": true
  },
  {
   "label": "Pip asks where the house goes",
   "eval": "store.phase.value",
   "equals": "place",
   "within": 90
  },
  {
   "label": "the view turns to a free spot",
   "eval": "probe.screen('spot:suggested')?.inside",
   "equals": true,
   "within": 30
  },
  {
   "wait": 1.5
  },
  {
   "label": "the ghost follows the cursor; a click places the house",
   "mouse": {
    "target": "spot:suggested",
    "action": "click"
   }
  },
  {
   "label": "the flock builds",
   "eval": "['build', 'goodnight', 'free'].includes(store.phase.value)",
   "equals": true,
   "within": 10
  },
  {
   "wait": 2
  },
  {
   "shot": "demo-desk-2-build.png"
  },
  {
   "label": "the island is free to wander",
   "eval": "store.phase.value",
   "equals": "free",
   "within": 240
  },
  {
   "label": "the house is remembered",
   "eval": "modules.mind.state.houses.length",
   "atLeast": 1
  },
  {
   "label": "walk with the keys",
   "eval": "(guide.setWalk(1, 0), true)",
   "equals": true
  },
  {
   "wait": 1.5
  },
  {
   "label": "stop walking",
   "eval": "(guide.setWalk(0, 0), store.walked.value)",
   "equals": true
  },
  {
   "shot": "demo-desk-3-free.png"
  },
  {
   "label": "a story by the fire, from its tag",
   "eval": "(document.querySelector('.tag-warm').click(), true)",
   "equals": true
  },
  {
   "label": "the paper theatre opens",
   "eval": "evening.stage.playing",
   "equals": true,
   "within": 60
  },
  {
   "wait": 8
  },
  {
   "shot": "demo-desk-4-story.png"
  },
  {
   "label": "next line",
   "eval": "(document.querySelector('.home-show .tag-small').click(), true)",
   "equals": true
  },
  {
   "wait": 4
  },
  {
   "shot": "demo-desk-5-story-next.png"
  },
  {
   "label": "that is enough for tonight",
   "eval": "(test.storyStop(), true)",
   "equals": true
  },
  {
   "label": "the theatre folds away",
   "eval": "evening.playing === null",
   "equals": true,
   "within": 40
  },
  {
   "label": "a song",
   "eval": "(test.concert(), true)",
   "equals": true
  },
  {
   "wait": 14
  },
  {
   "shot": "demo-desk-6-concert.png"
  },
  {
   "label": "the music stops",
   "eval": "(test.storyStop(), true)",
   "equals": true
  },
  {
   "label": "quiet again",
   "eval": "evening.playing === null",
   "equals": true,
   "within": 40
  },
  {
   "label": "a lantern",
   "eval": "(test.lantern(), true)",
   "equals": true
  },
  {
   "wait": 4
  },
  {
   "shot": "demo-desk-7-lantern.png"
  },
  {
   "label": "the painter paints the island",
   "eval": "(test.paint(), true)",
   "equals": true
  },
  {
   "wait": 30
  },
  {
   "shot": "demo-desk-8-painting.png"
  }
 ]
}