{
  "name": "probe 1: take the cube, carry it, snap onto the plate or return",
  "route": "/gallery?section=probe",
  "xr": true,
  "device": "metaQuest3",
  "mode": "hand",
  "steps": [
    { "label": "probe ready", "eval": "typeof handProbe !== 'undefined' && handProbe.reset() === undefined", "equals": true, "within": 30 },
    { "label": "pinch the cube by hand and carry it onto the plate", "run": { "device": "hand-right", "steps": [
      { "label": "take", "target": "probe:cube", "approach": { "distance": 0.06 }, "pinch": { "value": 1, "at": "arrival" } },
      { "label": "carry", "target": "probe:plate", "depart": { "distance": 0.05 }, "approach": { "distance": 0.04 }, "offset": { "normal": 0.03 } },
      { "label": "let go", "pinch": 0, "duration": 0.15 }
    ] } },
    { "label": "taken by the right hand", "eval": "handProbe.last('grab', 'probe:cube')?.input", "equals": "right" },
    { "label": "released over the plate: snapped", "eval": "handProbe.last('drop', 'probe:cube')?.hit", "equals": "probe:plate" },
    { "label": "lies on the plate", "eval": "(() => { const a = handProbe.at('cube'), b = handProbe.plate(); return Math.hypot(a[0] - b[0], a[1] - b[1], a[2] - b[2]); })()", "atMost": 0.012 },
    { "label": "take it again and let go in the air, away from any target", "run": { "device": "hand-right", "steps": [
      { "label": "take", "target": "probe:cube", "approach": { "distance": 0.06 }, "pinch": { "value": 1, "at": "arrival" } },
      { "label": "lift away", "position": { "relativeTo": "head", "x": 0.02, "y": -0.16, "z": -0.42 }, "depart": { "distance": 0.06 } },
      { "label": "let go", "pinch": 0, "duration": 0.15 }
    ] } },
    { "label": "missed: no target", "eval": "handProbe.last('drop', 'probe:cube')?.hit", "equals": null },
    { "label": "back where it was taken (the plate) within 0.4 s", "wait": 0.6 },
    { "label": "returned", "eval": "(() => { const a = handProbe.at('cube'), b = handProbe.plate(); return Math.hypot(a[0] - b[0], a[1] - b[1], a[2] - b[2]); })()", "atMost": 0.012 },
    { "shot": "probe-1.png" }
  ]
}
