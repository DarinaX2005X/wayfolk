{
  "name": "probe 5: dwell with the head pointer on Quest (no eye tracking)",
  "route": "/gallery?section=probe",
  "xr": true,
  "device": "metaQuest3",
  "mode": "hand",
  "steps": [
    { "label": "probe ready", "eval": "typeof handProbe !== 'undefined' && handProbe.reset() === undefined", "equals": true, "within": 30 },
    { "label": "dwell off (the setting is remembered on this device)", "eval": "(store.settings.value = { ...store.settings.peek(), dwell: false }, handProbe.reset(), true)", "equals": true },
    { "label": "look straight at the button", "head": { "position": [0, 1.6, 0], "yaw": 0, "pitch": 0, "recenter": false } },
    { "label": "wait longer than a dwell", "wait": 1.8 },
    { "label": "dwell off: nothing selected", "eval": "handProbe.count('select', 'probe:button')", "equals": 0 },
    { "label": "look away, then switch dwell on (slowest, 1.2 s)", "head": { "position": [0, 1.6, 0], "yaw": 25, "pitch": 0, "recenter": false } },
    { "label": "dwell on", "eval": "(store.settings.value = { ...store.settings.peek(), dwell: true, dwellMs: 1200 }, handProbe.reset(), true)", "equals": true },
    { "label": "nothing under the pointer", "eval": "dwell().target", "equals": null },
    { "label": "look at the button", "head": { "position": [0, 1.6, 0], "yaw": 0, "pitch": 0, "recenter": false } },
    { "label": "the head pointer finds it", "eval": "dwell().target", "equals": "probe:button", "within": 1 },
    { "label": "look away", "head": { "position": [0, 1.6, 0], "yaw": 25, "pitch": 0, "recenter": false } },
    { "label": "leaving resets the ring", "eval": "[dwell().phase, dwell().fill].join()", "equals": "idle,0" },
    { "label": "rest off the button past the cooldown", "wait": 1.2 },
    { "label": "mark the time and clear the log", "eval": "(window.__dwellFrom = clock.now(), handProbe.reset(), true)", "equals": true },
    { "label": "look back and keep looking", "head": { "position": [0, 1.6, 0], "yaw": 0, "pitch": 0, "recenter": false } },
    { "label": "selected by dwell", "eval": "handProbe.last('select', 'probe:button')?.input", "equals": "dwell", "within": 4 },
    { "label": "a full arm and fill from the moment of looking back (250 + 1200 ms)", "eval": "handProbe.last('select', 'probe:button').t - window.__dwellFrom", "atLeast": 1400 },
    { "label": "dwell off again", "eval": "(store.settings.value = { ...store.settings.peek(), dwell: false }, true)", "equals": true }
  ]
}
