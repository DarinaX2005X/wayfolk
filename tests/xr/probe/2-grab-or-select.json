{
  "name": "probe 2: one object, taken near by hand, selected from afar through its proxy",
  "route": "/gallery?section=probe",
  "xr": true,
  "device": "metaQuest3",
  "mode": "hand-ray",
  "steps": [
    { "label": "probe ready", "eval": "typeof handProbe !== 'undefined' && handProbe.reset() === undefined", "equals": true, "within": 30 },
    { "label": "the handle denies rays: IWSDK sets it on the grab node", "eval": "JSON.stringify(probe && app.world.scene.getObjectByName('probe:cube').pointerEventsType)", "equals": "{\"deny\":\"ray\"}" },
    { "label": "a ray pinch from afar lands on the proxy", "run": { "device": "hand-right", "steps": [ { "target": "probe:cube", "press": {} } ] } },
    { "label": "selected by ray", "eval": "handProbe.last('select', 'probe:cube')?.input", "equals": "ray" },
    { "label": "and not taken", "eval": "handProbe.count('grab', 'probe:cube')", "equals": 0 },
    { "label": "a pinch right at the cube takes it", "mode": "hand", "run": { "device": "hand-right", "steps": [
      { "label": "take", "target": "probe:cube", "approach": { "distance": 0.06 }, "pinch": { "value": 1, "at": "arrival" } },
      { "label": "lift a little", "position": { "relativeTo": "head", "x": -0.12, "y": -0.25, "z": -0.44 }, "depart": { "distance": 0.04 } }
    ] } },
    { "label": "taken", "mode": "hand", "eval": "handProbe.count('grab', 'probe:cube')", "equals": 1 },
    { "label": "and that pinch selected nothing", "mode": "hand", "eval": "handProbe.count('select', 'probe:cube')", "equals": 1 },
    { "label": "the proxy is hidden while the cube is held", "mode": "hand", "eval": "app.world.scene.getObjectByName('probe:cube:proxy').visible", "equals": false },
    { "label": "let go", "mode": "hand", "run": { "device": "hand-right", "steps": [ { "pinch": 0, "duration": 0.15 } ] } },
    { "label": "back home", "mode": "hand", "wait": 0.6 },
    { "label": "the proxy answers again", "mode": "hand", "eval": "app.world.scene.getObjectByName('probe:cube:proxy').visible", "equals": true }
  ]
}
