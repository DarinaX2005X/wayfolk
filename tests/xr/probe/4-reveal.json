{
  "name": "probe 4: a slip in the hand opens when lifted 6 cm toward you or turned 60°",
  "route": "/gallery?section=probe",
  "xr": true,
  "device": "metaQuest3",
  "mode": "hand",
  "steps": [
    { "label": "probe ready", "eval": "typeof handProbe !== 'undefined' && handProbe.reset() === undefined", "equals": true, "within": 30 },
    { "label": "take the slip and lift it toward the face, no turn", "run": { "device": "hand-right", "steps": [
      { "label": "take", "target": "probe:slip", "approach": { "distance": 0.05 }, "pinch": { "value": 1, "at": "arrival" } },
      { "label": "lift 9 cm toward the eyes", "position": { "relativeTo": "head", "x": 0.18, "y": -0.22, "z": -0.38 }, "depart": { "distance": 0.04 } }
    ] } },
    { "label": "opened by lifting", "eval": "handProbe.open()", "equals": true },
    { "label": "set it back down low: closes under 3 cm", "run": { "device": "hand-right", "steps": [
      { "label": "lower", "anchor": "grasp", "position": { "relativeTo": "head", "x": 0.2, "y": -0.305, "z": -0.42 } }
    ] } },
    { "label": "closed", "eval": "handProbe.open()", "equals": false },
    { "label": "let go", "run": { "device": "hand-right", "steps": [ { "pinch": 0, "duration": 0.15 } ] } },
    { "label": "the slip goes back to the tray", "wait": 0.6 },
    { "label": "take it again and turn it without lifting (palm turned 80°: the slip turns about 60° of it)", "run": { "device": "hand-right", "steps": [
      { "label": "take", "target": "probe:slip", "approach": { "distance": 0.05 }, "pinch": { "value": 1, "at": "arrival" } },
      { "label": "palm down", "anchor": "grasp", "position": { "relativeTo": "head", "x": 0.2, "y": -0.29, "z": -0.42 }, "orientation": { "fingers": [0, 0, -1], "palm": [0, -1, 0] }, "duration": 0.5 },
      { "label": "turn the palm 80° toward the thumb", "orientation": { "fingers": [0, 0, -1], "palm": [-0.985, -0.174, 0] }, "duration": 0.5 }
    ] } },
    { "label": "opened by turning", "eval": "handProbe.open()", "equals": true },
    { "label": "let go: it folds", "run": { "device": "hand-right", "steps": [ { "pinch": 0, "duration": 0.15 } ] } },
    { "label": "closed on release", "eval": "handProbe.open()", "equals": false },
    { "label": "two opens, two closes", "eval": "[handProbe.count('reveal-open'), handProbe.count('reveal-close')].join()", "equals": "2,2" }
  ]
}
