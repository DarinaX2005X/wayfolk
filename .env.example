# Groundwork: environment variables. Copy to .env.local for development; on Vercel set
# them in the project settings. Real values never go into this file or into logs.

# Model provider of /api/llm: fixtures (recorded answers, no network), openrouter or gemini.
LLM_PROVIDER=fixtures
# OpenRouter key; without it /api/llm reports live: false and the product uses recorded answers.
OPENROUTER_API_KEY=
# Model id, or several separated by commas: on a model refusal the next one is tried once.
LLM_MODEL=
# Model for voice commands (needs input_audio); empty means LLM_MODEL.
LLM_AUDIO_MODEL=
# Prices in USD per million tokens, used when the provider does not report the cost.
LLM_PRICE_IN=
LLM_PRICE_OUT=
# Spending limits of live runs for visitors, USD: per UTC day and for the whole deployment.
LLM_DAILY_USD=0.20
LLM_TOTAL_USD=6.00
# A new live run starts only if at least this much is left of both limits.
LLM_RUN_RESERVE_USD=0.08
# Estimated cost of one call, USD, for the "live runs left today" number.
LLM_EST_CALL_USD=
# Calls allowed per run id.
LLM_RUN_CALLS=32
# Live runs per address per day, and voice requests per address per day.
LLM_DAILY_RUNS_PER_ADDRESS=2
LLM_VOICE_CALLS_PER_ADDRESS=40
# Local development only: lets development scripts call the model past the visitor limits.
LLM_DEV_TOKEN=
# Gemini adapter (tested on a stubbed fetch only).
GEMINI_API_KEY=
GEMINI_MODEL=

# Vercel Blob store (private); files of uploads and exports, and small records without Redis.
BLOB_READ_WRITE_TOKEN=
# Upstash Redis REST, either pair of names given by the Vercel integration. Not configured now.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Storage driver of small records: redis, blob-json or memory (development).
STORAGE_DRIVER=blob-json
# 1 makes every write answer 503 storage-readonly while reads keep working.
STORAGE_READONLY=
# Monthly allowances of the free plans the counters stop at.
KV_MONTHLY_COMMANDS=400000
BLOB_MONTHLY_WRITES=1950
BLOB_MONTHLY_READS=8000
# Bytes of uploads per day.
UPLOAD_DAILY_BYTES=209715200

# Public TURN servers for the seating for two (comma separated) and their credential as name:password.
TURN_URLS=
TURN_CREDENTIAL=

# Owner key of the sample worlds seeded by scripts/seed-samples.mjs.
SAMPLES_OWNER_KEY=
