# Wayfolk: environment variables of the server routes (api/). Copy to .env.local for
# development; on Vercel set them in the project settings. Real values never go here.

# Model provider of /api/llm: off (prepared travelers and lines only), openrouter or gemini.
LLM_PROVIDER=off
# OpenRouter key; without it /api/llm says live: false and the island uses prepared travelers.
OPENROUTER_API_KEY=
# Model id for every task, or several separated by commas: on a refusal the next one is tried.
LLM_MODEL=
# Model for one task only (TRAVELER, TALK, EVENTS, GIFT, TRIP); empty means LLM_MODEL.
LLM_MODEL_TALK=
# Model for answers to the person's voice (it must take audio input); empty turns voice off.
LLM_AUDIO_MODEL=
# OpenRouter host preference: latency, throughput or price.
LLM_PROVIDER_SORT=
# Prices in USD per million tokens, used when the provider does not report the cost.
LLM_PRICE_IN=
LLM_PRICE_OUT=
# Spending limits for visitors, USD: per UTC day and for the whole deployment.
LLM_DAILY_USD=0.20
LLM_TOTAL_USD=6.00
# A new live visit starts only if at least this much is left of both limits.
LLM_RUN_RESERVE_USD=0.08
# Estimated cost of one call, USD, used before the provider reports the real one.
LLM_EST_CALL_USD=
# Model calls allowed within one visit.
LLM_RUN_CALLS=60
# Live visits per address per day, and voice answers per address per day.
LLM_DAILY_RUNS_PER_ADDRESS=6
LLM_VOICE_CALLS_PER_ADDRESS=40
# 1 lets visitors spend even when the spending counters live in one server instance only.
LLM_INSTANCE_COUNTERS=
# Local development only: lets development scripts call the model past the visitor limits.
LLM_DEV_TOKEN=
# Gemini key and model, when LLM_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=

# Vercel Blob store (private): saved islands, public islands and the spending counters.
BLOB_READ_WRITE_TOKEN=
# Upstash Redis REST, either pair of names the Vercel integration gives; optional.
KV_REST_API_URL=
KV_REST_API_TOKEN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Where small records live: redis, blob-json or memory (development).
STORAGE_DRIVER=blob-json
# 1 makes every write answer 503 while reads keep working.
STORAGE_READONLY=
# Monthly allowances of the free plans; the counters stop writes before them.
KV_MONTHLY_COMMANDS=400000
BLOB_MONTHLY_WRITES=1950
BLOB_MONTHLY_READS=8000
